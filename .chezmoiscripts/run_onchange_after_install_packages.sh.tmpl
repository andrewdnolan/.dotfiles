#!/bin/bash
# packages hash: {{ include "dot_config/mise/mise.toml.tmpl" | sha256sum }}
# cargo config hash: {{ include "dot_cargo/config.toml" | sha256sum }}

set -euo pipefail

MISE_BIN_PATH="{{ joinPath .chezmoi.homeDir ".local/bin/mise" }}"

if [[ ! -x "$MISE_BIN_PATH" ]]; then
    echo "mise not found or not executable: $MISE_BIN_PATH" >&2
    exit 1
fi

"$MISE_BIN_PATH" trust "{{ .chezmoi.homeDir }}/.config/mise"
"$MISE_BIN_PATH" install
