#!/bin/bash
# environment: {{ include "dot_config/spack/environments/chezmoi-tools/spack.yaml.tmpl" | sha256sum }}

set -e

{{- if .needs_spack }}

SPACK_ROOT="{{ .chezmoi.homeDir }}/.local/share/spack"
SPACK_ENV="{{ .chezmoi.homeDir }}/.config/spack/environments/chezmoi-tools"
BIN_DIR="{{ .chezmoi.homeDir }}/.local/bin"

mkdir -p "$BIN_DIR"

SPACK="${SPACK_ROOT}/bin/spack"

"${SPACK}" -e "${SPACK_ENV}" concretize -f
"${SPACK}" -e "${SPACK_ENV}" install

NVIM_PREFIX="$("${SPACK}" -e "${SPACK_ENV}" location -i neovim)"
TREE_SITTER_PREFIX="$("${SPACK}" -e "${SPACK_ENV}" location -i tree-sitter)"

ln -sfn "$NVIM_PREFIX/bin/nvim" "$BIN_DIR/nvim"
ln -sfn "$TREE_SITTER_PREFIX/bin/tree-sitter" "$BIN_DIR/tree-sitter"

{{- end }}
