export HISTFILESIZE=1000
export HISTSIZE=1000
export HISTTIMEFORMAT="%h %d %H:%M:%S "
export HISTIGNORE="history*:!*history*:clear:git status:date"

if [[ -d $HOME/.local/bin ]] ; then
  export PATH=$HOME/.local/bin:$PATH
fi

if [[ -f "$HOME/.config/bash/detect_machine.sh" ]]; then
  source "$HOME/.config/bash/detect_machine.sh"

  _machine="$(dotfiles_machine 2>/dev/null || true)"

  if [[ -n "$_machine" && -d "$HOME/.local/bin/$_machine" ]]; then
    export PATH="$HOME/.local/bin/$_machine:$PATH"
  fi

  unset _machine
fi

if command -v mise > /dev/null ; then
  eval "$(mise activate bash)"
  # mise's PROMPT_COMMAND hook rebuilds PATH on every prompt, which can
  # demote an active conda/pixi env bin below system paths.  This hook runs
  # after mise's and moves $CONDA_PREFIX/bin back to the front for any active
  # environment — pixi (PIXI_IN_SHELL=1) or conda (CONDA_SHLVL>0), but NOT
  # the base conda env which should not shadow the system python.
  _conda_env_path_hook() {
    [[ -z "${CONDA_PREFIX:-}" ]] && return
    # Fire for pixi envs (PIXI_IN_SHELL) OR non-base conda envs (CONDA_SHLVL>0
    # and CONDA_DEFAULT_ENV not "base").  pixi may leave CONDA_DEFAULT_ENV
    # unset, so treat empty as non-base.
    local _is_pixi="${PIXI_IN_SHELL:-}"
    local _conda_shlvl="${CONDA_SHLVL:-0}"
    local _conda_env="${CONDA_DEFAULT_ENV:-}"
    if [[ -z "${_is_pixi}" ]]; then
      # Pure conda: skip if base env or no active env level
      [[ "${_conda_shlvl}" -le 0 || "${_conda_env}" == "base" ]] && return
    fi
    local _env_bin="${CONDA_PREFIX}/bin"
    [[ "${PATH}" == "${_env_bin}:"* ]] && return
    # Remove any existing occurrence(s) then prepend to avoid accumulation.
    local _p="${PATH//${_env_bin}:}"
    _p="${_p//:${_env_bin}}"
    export PATH="${_env_bin}:${_p}"
  }
  PROMPT_COMMAND="${PROMPT_COMMAND:+${PROMPT_COMMAND}; }_conda_env_path_hook"
fi

# (neo)vim
if command -v nvim > /dev/null ; then
  export EDITOR="nvim"
  export VISUAL="nvim"
elif command -v vim > /dev/null ; then
  export EDITOR="vim"
  export VISUAL="vim"
fi

if command -v lsd > /dev/null ; then
  alias ls="lsd"
  alias ll="ls -lgh"
  alias la='ls -a'
  alias lla='ls -lgha'
  alias lt='ls --tree'
fi

# enable fzf autocompletion and key-bindings if found
if command -v fzf > /dev/null ; then
  eval "$(fzf --bash)"
fi

# use bat instead of cat
if command -v bat > /dev/null ; then
  alias cat="bat"
fi

# Easier navigation
alias ..="cd .."
alias ...="cd ../.."
alias ~="cd ~"
alias -- -="cd -"

# Make grep highlight search string in red
alias grep="grep --color"

{{- if eq .chezmoi.os "darwin" }}
# Suppress bash deprecation warning
export BASH_SILENCE_DEPRECATION_WARNING=1

# Configuration for DoD's HPCMP Kerberos Kit
export PATH="/usr/local/krb5/bin:/usr/local/ossh/bin:$PATH"
export KRB5_CONFIG=/etc/krb5.conf

# Git tab-completion (provided by macOS Command Line Tools)
_git_comp="/Library/Developer/CommandLineTools/usr/share/git-core/git-completion.bash"
if [[ -f "$_git_comp" ]]; then
  source "$_git_comp"
fi
unset _git_comp

_macos_funcs="${XDG_CONFIG_HOME:-$HOME/.config}/bash/macos.bash"
if [[ -f "$_macos_funcs" ]]; then
  source "$_macos_funcs"
fi
unset _macos_funcs
{{- end }}

# SLURM aliases
if command -v squeue > /dev/null ; then
    squeue_format=(%8u %.7a %.4D %.10P %8i %.2t %.10r %.10M %.10l %.8Q %j)
    alias sqa="squeue -o \"${squeue_format[@]}\" --sort=P,-t,-p"
    alias sq="sqa -u $USER"
    unset squeue_format
fi

_bash_prompt="${XDG_CONFIG_HOME:-$HOME/.config}/bash/prompt.bash"
if [[ -f "$_bash_prompt" ]]; then
    source "$_bash_prompt"
fi
unset _bash_profile

# Set miniforge installation directory
MINIFORGE_HOME="${HOME}/miniforge3"

# >>> conda initialize >>>
# !! Contents within this block are managed manually for version control !!
if [[ -d "$MINIFORGE_HOME" ]]; then
  __conda_setup="$("$MINIFORGE_HOME/bin/conda" 'shell.bash' 'hook' 2> /dev/null)"
  if [ $? -eq 0 ]; then
    eval "$__conda_setup"
  else
    if [ -f "$MINIFORGE_HOME/etc/profile.d/conda.sh" ]; then
      . "$MINIFORGE_HOME/etc/profile.d/conda.sh"
    else
      export PATH="$MINIFORGE_HOME/bin:$PATH"
    fi
  fi
  unset __conda_setup
fi
# <<< conda initialize <<<
