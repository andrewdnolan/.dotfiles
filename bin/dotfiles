#!/bin/bash

DOTFILES_DIRECTORY="${HOME}/.dotfiles"

source ./lib/utils

#######################################
# Install neovim into $NVIM_INSTALL_DIR (default: $HOME/.local).
# On Linux   – downloads the stable AppImage and places it at
#              $NVIM_INSTALL_DIR/bin/nvim.
# On macOS   – downloads the appropriate pre-built tarball and extracts
#              the full tree (bin/, lib/, share/) into $NVIM_INSTALL_DIR
#              so that the binary can locate its runtime files.
# Set NVIM_INSTALL_DIR before running to use a non-default location, e.g.
#   NVIM_INSTALL_DIR=/opt/local bin/dotfiles
#######################################
install_neovim() {
    local install_dir="${NVIM_INSTALL_DIR:-${HOME}/.local}"
    local bin_dir="${install_dir}/bin"

    if [[ -x "${bin_dir}/nvim" ]]; then
        e_success "neovim already installed at ${bin_dir}/nvim"
        return
    fi

    mkdir -p "${bin_dir}"

    if [[ $(uname) == "Darwin" ]]; then
        local arch
        arch=$(uname -m)   # arm64 or x86_64
        local tarball="nvim-macos-${arch}.tar.gz"
        local url="https://github.com/neovim/neovim/releases/latest/download/${tarball}"
        local tmpdir
        tmpdir=$(mktemp -d)

        e_header "Downloading neovim (${arch}) for macOS..."
        curl -fL -o "${tmpdir}/${tarball}" "${url}"
        # Extract the full tarball (bin/, lib/, share/) into $install_dir so
        # the binary can locate its runtime files at ../share/nvim/runtime.
        mkdir -p "${install_dir}"
        tar -xzf "${tmpdir}/${tarball}" -C "${install_dir}" --strip-components=1
        rm -rf "${tmpdir}"
    else
        local url="https://github.com/neovim/neovim/releases/latest/download/nvim-linux-x86_64.appimage"

        e_header "Downloading neovim AppImage for Linux..."
        curl -fL -o "${bin_dir}/nvim" "${url}"
        chmod u+x "${bin_dir}/nvim"
    fi

    e_success "neovim installed to ${bin_dir}/nvim"
}

# install the tmux package manager
if [[ ! -x "${HOME}/.tmux/plugins/tpm/tpm" ]]; then
    # Docs: https://github.com/tmux-plugins/tpm
    git clone "https://github.com/tmux-plugins/tpm" "${HOME}/.tmux/plugins/tpm"
fi

# install neovim if not already present
install_neovim

#######################################
#
#######################################
archive_dotfile(){

    # create the archive directory to copy dotfiles into
    backupdir="${HOME}/dotfiles_$(date +%Y-%m-%d_%H:%M:%S)" && mkdir $backupdir

    # copy the dotfiles to the archive direcotry
    find $HOME -maxdepth 1 \( -name ".bashrc" \
                           -o -name ".bash_profile" \
                           -o -name ".vimrc" \
                           -o -name ".tmux.conf" \
                           -o -name ".tmux/tmuxline.conf" \
                           -o -name ".gitconfig" \
                           -o -name ".gitignore" \) \
                           -exec cp {} $backupdir ";"

    # archive existing neovim config if present
    if [[ -e "${HOME}/.config/nvim" ]]; then
        cp -r "${HOME}/.config/nvim" "${backupdir}/nvim"
    fi

    # tar the acrhive dir
    tar -cvf "${backupdir}.tar" $backupdir
    # clean up
    rm -rf $backupdir

    e_success "Exisiting dotfiles archived in $(tput setaf 7)${backupdir}.tar$(tput sgr0)"
}

#######################################
#######################################
link() {
    # Force create/replace the symlink.
    ln -fs "${DOTFILES_DIRECTORY}/${1}" "${HOME}/${2}"
}

#######################################
#######################################
mirrorfiles() {
    # Force remove the vim directory if it's already there.
    if [ -e "${HOME}/.vim" ]; then
        rm -rf "${HOME}/.vim"
    fi

    mkdir -p "${HOME}/.tmux"
    mkdir -p "${HOME}/.config"

    # Create the necessary symbolic links between the `.dotfiles` and `HOME`
    # directory. The `bash_profile` sources other files directly from the
    # `.dotfiles` repository.
    link "shell/bashrc"       ".bashrc"
    link "shell/bash_profile" ".bash_profile"
    link "git/gitconfig"      ".gitconfig"
    link "git/gitignore"      ".gitignore"
    link "vim/vimrc"          ".vimrc"
    link "tmux/tmux.conf"     ".tmux.conf"
    link "tmux/tmuxline.conf" ".tmux/tmuxline.conf"
    # Symlink the whole neovim config directory
    link "nvim"               ".config/nvim"


    e_success "Dotfiles installation complete!"
}

e_header "Installing dotfiles..."

seek_confirmation "Warning: This step may overwrite your existing dotfiles."

if is_confirmed; then
    archive_dotfile
    mirrorfiles
    source ${HOME}/.bash_profile
else
    printf "Aborting...\n"
    exit 1
fi
